local function createButton(name)
    local btn = Instance.new("TextButton")
    btn.Parent = ContentFrame
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 13
    btn.Active = false
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local macroActive = false
local macroBtn = createButton("Зажим Z -> C ➔ V+Space: [ВЫКЛ]")

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.Z then
        if macroActive then return end
        macroActive = true
        
        if macroBtn then
            macroBtn.Text = "Зажим Z -> C ➔ V+Space: [ВКЛ]"
            macroBtn.BackgroundColor3 = Color3.fromRGB(50, 140, 70)
        end
        
        task.spawn(function()
            -- 1. Нажимаем C
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.C, false, game)
            end)
            
            -- Ждем 0.5 секунды, постоянно проверяя, не отпустил ли пользователь Z
            local startTime = tick()
            while tick() - startTime < 0.5 do
                if not UserInputService:IsKeyDown(Enum.KeyCode.Z) then
                    break
                end
                task.wait()
            end
            
            -- Если пользователь всё еще удерживает Z, прожимаем V и Space
            if UserInputService:IsKeyDown(Enum.KeyCode.Z) then
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                end)
                
                -- Держим клавиши активными, пока Z зажата
                while UserInputService:IsKeyDown(Enum.KeyCode.Z) do
                    task.wait()
                end
            end
            
            -- Мгновенно отпускаем все клавиши при прекращении удержания Z
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.C, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.V, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end)
            
            macroActive = false
            if macroBtn then
                macroBtn.Text = "Зажим Z -> C ➔ V+Space: [ВЫКЛ]"
                macroBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            end
        end)
    end
end)

-- Перетаскивание окна
local dragging, dragStart, startPos

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
